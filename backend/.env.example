# Voice Clone Shield — backend configuration
# Copy this file to .env and adjust values:   cp .env.example .env
# PROTOTYPE: never commit the real .env — .gitignore already excludes it (§23).

# §20 — demo mode MUST stay true unless real models are loaded and working.
# When true, services return clearly-labelled mock output instead of crashing.
DEMO_MODE=true

# §DEMO FALLBACK SYSTEM — true wires app/demo/* mocks for EVERY service so the
# full pipeline runs with zero models installed (the team's safety net).
USE_DEMO_SERVICES=false

# Model settings (used from Phases 3–5)
MODEL_PATH=
# IndicConformer is GATED on Hugging Face: visit
# https://huggingface.co/ai4bharat/indic-conformer-600m-multilingual,
# request access, then set ASR_BACKEND=indic_conformer + provide an HF token
# (huggingface-cli login). Until then faster-whisper runs behind the same
# interface (§6 fallback discipline).
ASR_MODEL=ai4bharat/indic-conformer-600m-multilingual
ASR_BACKEND=faster_whisper
WHISPER_MODEL=small
DEVICE=cpu

# Server (§12) — HOST must stay 0.0.0.0 so Flutter on a phone/emulator can
# reach the API over the LAN. Android emulator reaches the host via 10.0.2.2.
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Storage (used when the database is wired up in a later phase — §17)
DATABASE_PATH=data/shield.db
MAX_UPLOAD_MB=10

# Adaptive liveness (§ADAPTIVE LIVENESS) — challenge expires after this many
# seconds; late/replayed responses count as FAILED.
LIVENESS_EXPIRY_SECONDS=60

# PRIVACY-FIRST (§PRIVACY): true = never persist raw audio, metadata only.
# Keep true for the prototype; production adds consent/retention/encryption.
PRIVACY_MODE=true
