# Voice Clone Shield — backend configuration
# Copy this file to .env and adjust values:   cp .env.example .env
# PROTOTYPE: never commit the real .env — .gitignore already excludes it (§23).

# §20 — demo mode MUST stay true unless real models are loaded and working.
# When true, services return clearly-labelled mock output instead of crashing.
DEMO_MODE=true

# Model settings (used from Phases 3–4 onward, ignored in Phase 1)
MODEL_PATH=
ASR_MODEL=ai4bharat/indic-conformer-600m-multilingual
DEVICE=cpu

# Server (§12) — HOST must stay 0.0.0.0 so Flutter on a phone/emulator can
# reach the API over the LAN. Android emulator reaches the host via 10.0.2.2.
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Storage (used when the database is wired up in a later phase — §17)
DATABASE_PATH=data/shield.db
MAX_UPLOAD_MB=10
